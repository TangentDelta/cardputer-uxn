|00 @System/vector $2 &expansion $2 &wst $1 &rst $1 &metadata $2 &r $2 &g $2 &b $2 &debug $1 &state $1
|10 @Console/vector $2 &read $5 &type $1 &write $1 &error $1
|a0 @File1/vector $2 &success $2 &stat $2 &delete $1 &append $1 &name $2 &length $2 &read $2 &write $2

|0000
@do-terminate $1
@ptr $1
@path $40
@buffer $80

|100
@on-reset ( -> )
	;meta #06 DEO2
	.Console/type DEI ?{ 
		#2e .path STZ ( '.' )
		print-dir
		!terminate-okay
	}
	.path .ptr STZ
	;on-console-args .Console/vector DEO2
	BRK

@meta 00 
	( Body )
	00
	( Extended metadata )
	01
	f0 2000 ( ROM capabilities. 1024 bytes of memory, 16 bytes of stack, and no screen or expansion )

@on-console-args
	.do-terminate LDZ #00 EQU ?{ BRK }
	.Console/type DEI #02 EQU ?on-arg
    .Console/type DEI #03 EQU ?on-spacer
    .Console/type DEI #04 EQU ?on-end
	BRK

@on-arg
	.Console/read DEI
	.ptr LDZ INCk .ptr STZ
	STZ BRK

@on-end
	#01 .do-terminate STZ
	( Falls through to on-spacer )

@on-spacer
	#00 .ptr LDZ STZ
	.path .ptr STZ
	print-dir
	.do-terminate LDZ ?terminate-okay
	BRK

@print-dir
	;path .File1/name DEO2
	#007f .File1/length DEO2	( 1 less than the buffer for null-termination )
	&print-dir-loop
	;buffer .File1/read DEO2
	( The chunk is null-terminated for us already )
	;buffer str/<print>
	( Loop again if there are more bytes to read )
	.File1/success DEI2 ORA ?/print-dir-loop
	JMP2r

@terminate-error
	#01 .do-terminate STZ
	#01 .System/state DEO
	BRK

@terminate-okay
	#01 .do-terminate STZ
	#80 .System/state DEO
	BRK

@str/<print> ( str* -- )
	LDAk DUP ?{ POP POP2 JMP2r }
	.Console/write DEO
	INC2 !/<print>