|10 @Console/vector $2 &read $5 &type $1 &write $1 &error $1

|100
@on-reset ( -> )
    ;meta #06 DEO2
    ;test-str str/<print>
    BRK


@meta 00 
	( Body )
	00
	( Extended metadata )
	01
	f0 1000 ( ROM capabilities. 1024 bytes of memory, 16 bytes of stack, and no screen or expansion )

@str/<print> ( str* -- )
	LDAk DUP ?{ POP POP2 JMP2r }
	.Console/write DEO
	INC2 !/<print>

