|00 @System/vector $2 &expansion $2 &wst $1 &rst $1 &metadata $2 &r $2 &g $2 &b $2 &debug $1 &state $1
|10 @Console/vector $2 &read $5 &type $1 &write $1 &error $1
|a0 @File1/vector $2 &success $2 &stat $2 &delete $1 &append $1 &name $2 &length $2 &read $2 &write $2

|00 @cat/do-terminate ( Flag to end the program )

|100
@on-reset ( -> )
	;meta #06 DEO2
	;cat/on-console-args .Console/vector DEO2
	#0100 .File1/length DEO2
	;cat/path .File1/name DEO2
	BRK

@meta 00 
	( Body )
	00
	( Extended metadata )
	01
	f0 2000 ( ROM capabilities. 1024 bytes of memory, 16 bytes of stack, and no screen or expansion )

@cat/on-console-args ( -> )
	( Is there a better way to do a switch statement in Uxntal? )
	.Console/type DEI
	#02 EQUk ?/on-arg POP
	#03 EQUk ?/on-spacer POP
	#04 EQUk ?/on-end POP
	BRK

@cat/on-console
	BRK

@cat/on-arg ( type -> )
	POP ( Get rid of the console type )
	.Console/read DEI ( Grab the next argument character )
	[ LIT2 &ptr =/path ] INC2k ,&ptr STR2 ( Increment the pointer into the path buffer )
	STA BRK	( Store the character and stop executing )

@cat/on-end ( type -> )
	;cat/on-console .Console/vector DEO2	( We're done with the console but still need to catch stdin and the terminator )
	#01 .&do-terminate STZ	( Set flag for termination when we're done )
	( Fall through to on-spacer )

@cat/on-spacer ( type -> )
	POP ( Get rid of the console type )
	#00 ;&ptr LDA STA	( Null-terminate the file path )
	;/path ;&ptr STA2 ( Reset the pointer to the start of the path buffer )
	!/read-file ( Read out the file to the console )

@cat/read-file ( -> )
	;/path .File1/name DEO2

	( Loops until all chunks of the file are read out )
	&read-file-loop
		;/chunk-buf .File1/read DEO2 ( Read out a chunk )
		.File1/success DEI2
		ORAk ?{ ./do-terminate LDZ ?/terminate BRK }	( 0 chunks read, exit if this is the last file )
		/print-buffer ( A chunk was read, output it )
		!&read-file-loop ( Loop again )

( Outputs the contents of the read buffer to the console )
@cat/print-buffer ( buffer_length -- )
	[ LIT2 &read-ptr =/chunk-buf ] INC2k ,&read-ptr STR2
	LDA .Console/write DEO
	#0001 SUB2 ORAk ?{ POP2 ;/chunk-buf ,&read-ptr STR2 JMP2r }
	!/print-buffer
	
( End the program with an "okay" status )
@cat/terminate ( -- )
	#80 .System/state DEO
	BRK


@cat/path "/ $64
@cat/chunk-buf $100